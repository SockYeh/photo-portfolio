---
/**
 * Signup form for the photo newsletter.
 *
 * Posts straight to Supabase's REST API from the browser using the publishable
 * key, so there is no backend to deploy. That key is safe to expose by design;
 * what actually protects the table is the INSERT-only RLS policy in
 * supabase/001_subscribers.sql.
 *
 * The key goes on the `apikey` header only. Supabase's publishable keys are not
 * JWTs, so putting them on `Authorization: Bearer` gets the request rejected
 * with "Invalid JWT".
 *
 * Renders nothing when the Supabase env vars are absent, so local builds and
 * forks do not render a form that cannot work.
 */
const url = import.meta.env.PUBLIC_SUPABASE_URL;
const publishableKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
const enabled = Boolean(url && publishableKey);
---

{
  enabled && (
    <section class="subscribe" id="subscribe">
      <h2 class="subscribe-title">new photos, occasionally</h2>
      <p class="subscribe-copy">
        get an email when something new is posted. no spam, unsubscribe anytime.
      </p>

      <form class="subscribe-form" id="subscribe-form" novalidate>
        <label class="visually-hidden" for="subscribe-email">Email address</label>
        <input
          id="subscribe-email"
          name="email"
          type="email"
          required
          placeholder="you@example.com"
          autocomplete="email"
          spellcheck="false"
        />
        <button type="submit">Subscribe</button>
      </form>

      <p class="subscribe-note" id="subscribe-note" role="status" aria-live="polite" />

      <p class="subscribe-alt">
        or{" "}
        <a href="/rss.xml">follow via RSS</a>
      </p>

      <script is:inline define:vars={{ supabaseUrl: url, publishableKey }}>
        const form = document.getElementById("subscribe-form");
        const note = document.getElementById("subscribe-note");

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();

          const input = form.querySelector('input[type="email"]');
          const button = form.querySelector("button");
          const email = input.value.trim();

          if (!email) return;

          button.disabled = true;
          note.textContent = "Subscribing…";
          note.dataset.state = "pending";

          try {
            const res = await fetch(`${supabaseUrl}/rest/v1/subscribers`, {
              method: "POST",
              headers: {
                // apikey only: these keys are not JWTs, so Authorization: Bearer
                // would be rejected with "Invalid JWT".
                apikey: publishableKey,
                "Content-Type": "application/json",
                // Returning zero rows keeps the response body free of the address.
                Prefer: "return=minimal",
              },
              body: JSON.stringify({ email }),
            });

            // 201 = inserted, 409 = already subscribed. Both are a success for the
            // person in front of the form, and neither should reveal who is on the list.
            if (res.ok || res.status === 409) {
              note.textContent = "You're on the list. Check your inbox to confirm.";
              note.dataset.state = "ok";
              form.reset();
            } else {
              throw new Error(`signup failed (${res.status})`);
            }
          } catch (err) {
            note.textContent = "That didn't work — try again in a moment.";
            note.dataset.state = "error";
            console.error(err);
          } finally {
            button.disabled = false;
          }
        });
      </script>
    </section>
  )
}

<style>
  .subscribe {
    margin: 40px 0 8px;
    padding: 28px 20px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    text-align: center;
  }

  .subscribe-title {
    margin: 0 0 6px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .subscribe-copy {
    margin: 0 0 18px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--fg-dim);
  }

  .subscribe-form {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 420px;
    margin: 0 auto;
  }

  .subscribe-form input {
    flex: 1 1 220px;
    min-width: 0;
    padding: 11px 13px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    background: var(--bg-elevated);
    color: var(--fg);
    font-size: 14px;
    font-family: inherit;
  }

  .subscribe-form input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .subscribe-form input:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.5);
    outline-offset: 1px;
  }

  .subscribe-form button {
    padding: 11px 20px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    background: #f2f2f2;
    color: #191919;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .subscribe-form button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .subscribe-note {
    min-height: 18px;
    margin: 12px 0 0;
    font-size: 12px;
    color: var(--fg-dim);
  }

  .subscribe-note[data-state="ok"] {
    color: #8fd18f;
  }

  .subscribe-note[data-state="error"] {
    color: #e0736a;
  }

  .subscribe-alt {
    margin: 10px 0 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .subscribe-alt a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .subscribe-alt a:hover {
    color: var(--fg);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
