---
import Base from "../layouts/Base.astro";
import rawData from "../data/photos.json";
import type { Photo, PhotosData } from "../lib/types";

const data = rawData as PhotosData;
const { user, profile } = data;
const photos: Photo[] = data.photos;
const count = photos.length;

const about = `I'm Sahran (SockYeh), a hobbyist photographer who shoots on his phone.`;
const bio = (about.trim() || profile?.description || "").trim();
const displayName = (profile?.name || user || "SockYeh").toUpperCase();
---

<Base title="SockYeh's Gallery" description="Photography by SockYeh">
  <div class="shell">
    <section class="about">
      <div class="about-avatar">
        {profile?.image && (
          <img
            src={profile.image}
            alt={profile.name || displayName}
            width={96}
            height={96}
            loading="eager"
            decoding="async"
          />
        )}
      </div>
      <h1 class="about-name">{displayName}</h1>
      <p class="about-meta">photo gallery · {count}</p>
      {bio && <p class="about-text">{bio}</p>}
      <div class="about-links">
        <a href="https://sockyeh.dev" rel="me noopener noreferrer" target="_blank">portfolio</a>
        <a href="https://instagram.com/shotyeh" rel="me noopener noreferrer" target="_blank">instagram</a>
        <a href="https://vsco.co/sockyeh" rel="me noopener noreferrer" target="_blank">vsco</a>
      </div>
    </section>

    <main>
      {
        count > 0 ? (
          <div class="grid" id="grid">
            {photos.map((p, i) => (
              <div class="tile-wrap">
                <button
                  type="button"
                  class="tile"
                  data-idx={i}
                  aria-label={p.caption ? `Open photo: ${p.caption}` : `Open photo ${i + 1}`}
                >
                  <img
                    src={p.full}
                    alt={p.caption || `Photo ${i + 1}`}
                    width={p.width || undefined}
                    height={p.height || undefined}
                    loading="lazy"
                    decoding="async"
                  />
                  {
                    p.caption && (
                      <span class="tile-caption">{p.caption}</span>
                    )
                  }
                </button>
              </div>
            ))}
          </div>
        ) : (
          <p class="empty">
            No photos yet — run <code>npm run sync</code> then rebuild.
          </p>
        )
      }
    </main>

    <footer class="site-footer">
      <span>SockYeh</span>
      <a href="https://sockyeh.dev" rel="me">sockyeh.dev</a>
    </footer>
  </div>

  <div class="lightbox" id="lightbox" hidden aria-hidden="true" role="dialog" aria-label="Photo viewer">
    <button type="button" class="lb-btn lb-close" id="lb-close" aria-label="Close">✕</button>
    <button type="button" class="lb-btn lb-prev" id="lb-prev" aria-label="Previous photo">‹</button>
    <div class="lb-stage">
      <img id="lb-img" alt="" />
      <video id="lb-video" controls hidden></video>
      <div class="lb-caption">
        <span class="lb-title" id="lb-title"></span>
        <span class="lb-count" id="lb-count"></span>
      </div>
    </div>
    <button type="button" class="lb-btn lb-next" id="lb-next" aria-label="Next photo">›</button>
  </div>

  <button class="arttech-toggle" id="arttech-toggle" type="button" aria-label="Open portfolio">
    <span class="arttech-toggle-track">
      <svg class="arttech-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
        <circle cx="12" cy="13" r="4" />
      </svg>
      <span class="arttech-knob"></span>
      <svg class="arttech-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 17l6-6-6-6" />
        <path d="M12 19h8" />
      </svg>
    </span>
  </button>

  <div class="boot-overlay" id="boot-overlay" aria-hidden="true">
    <pre class="boot-tux" aria-hidden="true">    .--.
   |o_o |
   |:_/ |
  //   \ \
 (|     | )
/'\_   _/`\
\___)=(___/</pre>
    <p class="boot-title">Linux sockyeh 6.9.3-gallery x86_64</p>
    <div class="boot-logs" id="boot-logs"></div>
    <div class="boot-bar" aria-hidden="true">
      <div class="boot-bar-fill" id="boot-bar-fill"></div>
    </div>
  </div>
  <div class="boot-flash" id="boot-flash" aria-hidden="true"></div>

  <script type="application/json" is:inline id="photos-data" set:html={JSON.stringify(photos).replace(/</g, "\\u003c")} />

  <script>
    interface Photo {
      id: string;
      full: string;
      thumb: string;
      width?: number;
      height?: number;
      caption?: string;
      date?: number;
      video?: boolean;
      tags?: string[];
    }

    const dataEl = document.getElementById("photos-data") as HTMLScriptElement;
    const photos: Photo[] = JSON.parse(dataEl.textContent || "[]");

    const grid = document.getElementById("grid") as HTMLDivElement;
    const tileWraps = Array.from(grid.children) as HTMLElement[];

    function layoutMasonry() {
      const cols = window.innerWidth < 1000 ? 2 : 3;
      let columns = Array.from(grid.children).filter((el) =>
        (el as HTMLElement).classList.contains("mcol"),
      ) as HTMLElement[];
      if (columns.length !== cols) {
        grid.classList.add("masonry");
        grid.innerHTML = "";
        columns = Array.from({ length: cols }, () => {
          const col = document.createElement("div");
          col.className = "mcol";
          grid.appendChild(col);
          return col;
        });
      } else {
        columns.forEach((col) => (col.innerHTML = ""));
      }

      const heights = new Array(cols).fill(0);
      tileWraps.forEach((wrap, i) => {
        const p = photos[i];
        const ratio = p?.width && p?.height ? p.height / p.width : 1;
        let min = 0;
        for (let c = 1; c < cols; c++) {
          if (heights[c] < heights[min]) min = c;
        }
        heights[min] += ratio;
        columns[min].appendChild(wrap);
      });
    }

    layoutMasonry();
    let resizeRaf = 0;
    window.addEventListener("resize", () => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(layoutMasonry);
    });

    const lightbox = document.getElementById("lightbox") as HTMLDivElement;
    const img = document.getElementById("lb-img") as HTMLImageElement;
    const video = document.getElementById("lb-video") as HTMLVideoElement;
    const titleEl = document.getElementById("lb-title") as HTMLSpanElement;
    const countEl = document.getElementById("lb-count") as HTMLSpanElement;
    const closeBtn = document.getElementById("lb-close") as HTMLButtonElement;
    const prevBtn = document.getElementById("lb-prev") as HTMLButtonElement;
    const nextBtn = document.getElementById("lb-next") as HTMLButtonElement;

    let idx = 0;
    let open = false;

    function formatDate(ts?: number): string {
      if (!ts) return "";
      return new Date(ts).toLocaleDateString("en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
      });
    }

    function render() {
      const p = photos[idx];
      if (!p) return;

      titleEl.textContent = p.caption || formatDate(p.date) || "";
      countEl.textContent = `${idx + 1} / ${photos.length}`;

      if (p.video) {
        img.hidden = true;
        video.hidden = false;
        if (video.src !== p.full) {
          video.src = p.full;
          video.play().catch(() => {});
        }
      } else {
        video.pause();
        video.hidden = true;
        img.hidden = false;
        if (img.src !== p.full) img.src = p.full;
      }

      prevBtn.disabled = idx === 0;
      nextBtn.disabled = idx === photos.length - 1;
    }

    function openAt(i: number) {
      idx = i;
      open = true;
      lightbox.hidden = false;
      lightbox.setAttribute("aria-hidden", "false");
      document.body.classList.add("lb-open");
      render();
    }

    function closeLightbox() {
      open = false;
      lightbox.hidden = true;
      lightbox.setAttribute("aria-hidden", "true");
      document.body.classList.remove("lb-open");
      video.pause();
      video.removeAttribute("src");
      video.load();
    }

    document.querySelectorAll<HTMLButtonElement>(".tile").forEach((tile) => {
      tile.addEventListener("click", () => {
        const i = Number(tile.dataset.idx);
        if (!Number.isNaN(i)) openAt(i);
      });
    });

    closeBtn.addEventListener("click", closeLightbox);
    prevBtn.addEventListener("click", () => idx > 0 && openAt(idx - 1));
    nextBtn.addEventListener("click", () => idx < photos.length - 1 && openAt(idx + 1));

    document.addEventListener("keydown", (e) => {
      if (!open) return;
      if (e.key === "Escape") closeLightbox();
      else if (e.key === "ArrowLeft" && idx > 0) openAt(idx - 1);
      else if (e.key === "ArrowRight" && idx < photos.length - 1) openAt(idx + 1);
    });
  </script>

  <script>
    const PORTFOLIO_URL = "https://sockyeh.dev";
    const TYPE_MS = 2;
    const LINE_GAP_MS = 35;
    const BOOT_MS = 850;

    const toggleBtn = document.getElementById("arttech-toggle") as HTMLButtonElement;
    const overlay = document.getElementById("boot-overlay") as HTMLDivElement;
    const logsEl = document.getElementById("boot-logs") as HTMLDivElement;
    const barFill = document.getElementById("boot-bar-fill") as HTMLDivElement;
    const flashEl = document.getElementById("boot-flash") as HTMLDivElement;

    interface BootLine {
      prefix: string;
      text: string;
      cls: string;
    }

    const LINES: BootLine[] = [
      { prefix: "[    0.000000] ", text: "Linux version 6.9.3-arch1-1-sockyeh (gcc 14.1.1)", cls: "kern" },
      { prefix: "[    0.012345] ", text: "Memory: 16384M available", cls: "kern" },
      { prefix: "[  OK  ] ", text: "Started SockYeh Gallery Daemon.", cls: "ok" },
      { prefix: "[  OK  ] ", text: "Reached target Camera Stack.", cls: "ok" },
      { prefix: "[  OK  ] ", text: "Mounting /mnt/portfolio...", cls: "ok" },
      { prefix: "[  OK  ] ", text: "Mounted /mnt/portfolio.", cls: "ok" },
      { prefix: "[  OK  ] ", text: "Starting SockYeh Portfolio...", cls: "ok" },
      { prefix: "[    0.847129] ", text: "Booting into portfolio at sockyeh.dev", cls: "kern" },
    ];

    function typeLine(line: BootLine): Promise<void> {
      return new Promise((resolve) => {
        const el = document.createElement("div");
        el.className = "boot-line";

        const prefix = document.createElement("span");
        prefix.className = line.cls === "ok" ? "boot-ok" : "boot-kern";
        prefix.textContent = line.prefix;

        const text = document.createElement("span");
        el.append(prefix, text);

        const cursor = document.createElement("span");
        cursor.className = "boot-cursor";
        el.appendChild(cursor);

        logsEl.appendChild(el);
        logsEl.scrollTop = logsEl.scrollHeight;

        let i = 0;
        const timer = setInterval(() => {
          text.textContent = line.text.slice(0, ++i);
          logsEl.scrollTop = logsEl.scrollHeight;
          if (i >= line.text.length) {
            clearInterval(timer);
            cursor.remove();
            resolve();
          }
        }, TYPE_MS);
      });
    }

    async function runBoot() {
      overlay.classList.add("show");

      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        barFill.style.width = "100%";
        await new Promise((r) => setTimeout(r, 250));
        window.location.href = PORTFOLIO_URL;
        return;
      }

      const start = performance.now();
      requestAnimationFrame(function fill(now) {
        const t = Math.min(1, (now - start) / BOOT_MS);
        barFill.style.width = `${(t * 100).toFixed(1)}%`;
        if (t < 1) requestAnimationFrame(fill);
      });

      for (const line of LINES) {
        await typeLine(line);
        await new Promise((r) => setTimeout(r, LINE_GAP_MS));
      }
      barFill.style.width = "100%";
      flashEl.classList.add("go");
      await new Promise((r) => setTimeout(r, 120));
      window.location.href = PORTFOLIO_URL;
    }

    toggleBtn.addEventListener("click", () => {
      if (toggleBtn.classList.contains("switching")) return;
      toggleBtn.classList.add("switching");
      setTimeout(runBoot, 100);
    });
  </script>
</Base>
