# Public config — inlined into the static site at build time.
# Both values are safe to commit to a public repo; the publishable key is
# designed to ship in browser JS. RLS is what restricts it, not secrecy.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only config for `npm run notify`. Never prefix these with PUBLIC_,
# or your bundler will embed them in the built site.
# Read by scripts/notify.mjs and scripts/sync-and-publish.sh.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
RESEND_API_KEY=re_...
RESEND_SEGMENT_ID=...
NOTIFY_FROM=SockYeh's Gallery <gallery@yourdomain.com>
SITE_URL=https://gallery.sockyeh.dev

# Set to 1 to print the email instead of sending it.
# NOTIFY_DRY_RUN=1
